{
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/",
      "framework": "create-react-app"
    },
    "backend": {
      "entrypoint": "backend",
      "routePrefix": "/_/backend"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/_/backend/api/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
