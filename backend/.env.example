# ─── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# NODE_ENV=production

# ─── Database ───────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/otaku
# Production: use MongoDB Atlas connection string
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/otaku?retryWrites=true&w=majority

# ─── Auth ───────────────────────────────────────────────
# IMPORTANT: Change JWT_SECRET to a strong random string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=otaku_super_secret_jwt_key_2026_change_me
JWT_EXPIRE=30d
GOOGLE_CLIENT_ID=your_google_client_id_here

# ─── CORS ───────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
# Production: CORS_ORIGIN=https://otakuweeb.me,https://www.otakuweeb.me

# ─── Email (Gmail or SendGrid) ─────────────────────────
# Gmail: use App Password (not your regular password)
# https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=
CLIENT_URL=http://localhost:3000
# Production: CLIENT_URL=https://otakuweeb.me

# ─── Push Notifications (VAPID) ────────────────────────
# Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@otakuweeb.me

# ─── LiveKit (Watch Together) ──────────────────────────
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-livekit-instance.com

# ─── OAuth Sync (MAL / AniList) ────────────────────────
# Register at https://myanimelist.net/apiconfig (MAL) and https://anilist.co/settings/developer (AniList)
# Redirect URIs (dev): http://localhost:3000/auth/sync/{mal,anilist}/callback
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# ─── External API URLs ─────────────────────────────────
ANILIST_API_URL=https://graphql.anilist.co
MANGADEX_API_URL=https://api.mangadex.org
MANGADEX_BASE_URL=https://mangadex.org/

# ─── Scraper URLs ──────────────────────────────────────
MANGANATO_BASE_URL=https://readmanganato.com
TOONILY_BASE_URL=https://toonily.com
BATO_BASE_URL=https://bato.to
ANIMECHAN_API_URL=https://animechan.xyz/api
ANIPUB_BASE_URL=https://anipub.xyz
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
