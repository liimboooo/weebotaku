{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "api/socket.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/socket(.*)", "dest": "api/socket.js" },
    { "src": "/(.*)", "dest": "api/index.js" }
  ],
  "crons": [
    {
      "path": "/api/health",
      "schedule": "*/5 * * * *"
    }
  ]
}
